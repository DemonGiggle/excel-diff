<Window x:Class="ExcelDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExcelDiff.Models"
        Title="Excel Compare" Height="820" Width="1220" MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" Padding="24,18">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Excel Compare" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="A clear, unified view of workbook changes" Foreground="#BFC9DA" Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="New comparison" Click="NewComparison_Click"
                        Background="#2A354B" Foreground="White" BorderBrush="#66738A"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="WorkflowTabs" Grid.Row="1" Margin="18" Background="White">
            <TabItem x:Name="FilesTab" Header="  1  Choose sheets  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32" MaxWidth="980">
                        <TextBlock Text="Choose the two worksheets" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="The app compares every saved value from A1 through the furthest populated cell. Files remain local and read-only."
                                   Foreground="{StaticResource Muted}" Margin="0,6,0,22" TextWrapping="Wrap"/>

                        <Border BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Older workbook" FontWeight="SemiBold" Margin="4,0,0,8"/>
                                <TextBox x:Name="OldFileText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsReadOnly="True" MinHeight="38"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseOld_Click"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Worksheet" VerticalAlignment="Center" Margin="4,10,8,0"/>
                                <ComboBox x:Name="OldSheetCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="38" Margin="4,10,4,4"/>
                            </Grid>
                        </Border>

                        <Border BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Newer workbook" FontWeight="SemiBold" Margin="4,0,0,8"/>
                                <TextBox x:Name="NewFileText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsReadOnly="True" MinHeight="38"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseNew_Click"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Worksheet" VerticalAlignment="Center" Margin="4,10,8,0"/>
                                <ComboBox x:Name="NewSheetCombo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" MinHeight="38" Margin="4,10,4,4"/>
                            </Grid>
                        </Border>

                        <Button Content="Compare worksheets" Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Right" Click="Compare_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="ResultsTab" Header="  2  Unified diff  " IsEnabled="False">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Worksheet differences" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ResultSubtitle" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PreviousDifferenceButton" Content="← Previous change" Click="PreviousDifference_Click"/>
                            <Button x:Name="NextDifferenceButton" Content="Next change →" Style="{StaticResource PrimaryButton}" Click="NextDifference_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#F5F7FB" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock x:Name="DifferencePositionText" DockPanel.Dock="Right" Text="No changed rows" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FDE8E8" Padding="7,3" Margin="0,0,8,0"><TextBlock Text="Removed" Foreground="#9F2020" TextDecorations="Strikethrough"/></Border>
                                <Border Background="#E1F5E8" Padding="7,3" Margin="0,0,8,0"><TextBlock Text="Added" Foreground="#126B35"/></Border>
                                <Border Background="White" BorderBrush="#DDE3ED" BorderThickness="1" Padding="7,3"><TextBlock Text="Unchanged"/></Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DataGrid x:Name="DiffGrid" Grid.Row="2" IsReadOnly="True" SelectionMode="Single"
                              SelectionUnit="FullRow" FrozenColumnCount="1" EnableColumnVirtualization="True"
                              EnableRowVirtualization="True" HeadersVisibility="Column" CanUserReorderColumns="False">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:UnifiedRowKind.Changed}"><Setter Property="Background" Value="#FFFCF4"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:UnifiedRowKind.Added}"><Setter Property="Background" Value="#F0FAF3"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:UnifiedRowKind.Removed}"><Setter Property="Background" Value="#FFF2F2"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:UnifiedRowKind.Fold}">
                                        <Setter Property="Background" Value="#EEF2F7"/>
                                        <Setter Property="Foreground" Value="#607089"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3ED" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="Offline • Read-only sources • .xlsx / .xls" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="#AA172033" Visibility="Collapsed">
            <Border Background="White" CornerRadius="8" Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" Text="Working…" FontSize="20" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="BusyProgress" Height="12" Minimum="0" Maximum="100" Margin="0,18,0,12"/>
                    <TextBlock Text="Large worksheets may take a few moments. Your files stay on this computer." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
