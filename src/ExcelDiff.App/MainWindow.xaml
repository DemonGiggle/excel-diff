<Window x:Class="ExcelDiff.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ExcelDiff.Models"
        Title="Excel Compare" Height="820" Width="1220" MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172033" Padding="24,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Excel Compare" Foreground="White" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="Clear, private workbook differences — entirely on this computer" Foreground="#BFC9DA" Margin="0,3,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="New comparison" Click="NewComparison_Click" Background="#2A354B" Foreground="White" BorderBrush="#66738A"/>
            </DockPanel>
        </Border>

        <TabControl x:Name="WorkflowTabs" Grid.Row="1" Margin="18" Background="White">
            <TabItem x:Name="FilesTab" Header="  1  Select files  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="32" MaxWidth="980">
                        <TextBlock Text="Choose the two workbooks" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Your files stay on this computer and are opened read-only. Only modern .xlsx workbooks are accepted." Foreground="{StaticResource Muted}" Margin="0,6,0,22"/>

                        <Border BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Older workbook" FontWeight="SemiBold" Margin="4,0,0,8"/>
                                <TextBox x:Name="OldFileText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsReadOnly="True" MinHeight="38"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseOld_Click"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Newer workbook" FontWeight="SemiBold" Margin="4,0,0,8"/>
                                <TextBox x:Name="NewFileText" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" IsReadOnly="True" MinHeight="38"/>
                                <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Click="BrowseNew_Click"/>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Older sheet" FontWeight="SemiBold" Margin="4"/>
                                <ComboBox x:Name="OldSheetCombo" MinHeight="38"/>
                                <TextBlock Text="Header row" FontWeight="SemiBold" Margin="4,12,4,0"/>
                                <TextBox x:Name="OldHeaderRowText" Text="1" MinHeight="38"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Newer sheet" FontWeight="SemiBold" Margin="4"/>
                                <ComboBox x:Name="NewSheetCombo" MinHeight="38"/>
                                <TextBlock Text="Header row" FontWeight="SemiBold" Margin="4,12,4,0"/>
                                <TextBox x:Name="NewHeaderRowText" Text="1" MinHeight="38"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Review field mapping" Style="{StaticResource PrimaryButton}" Click="PrepareMapping_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="MappingTab" Header="  2  Match fields  " IsEnabled="False">
                <Grid Margin="28">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Review fields and choose the row key" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Fields with the same name are paired automatically. Select one or more fields that uniquely identify each row." Foreground="{StaticResource Muted}" Margin="0,6,0,16"/>
                    </StackPanel>
                    <DataGrid x:Name="MappingGrid" Grid.Row="1" ItemsSource="{Binding Mappings}" Margin="0,0,0,12">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Compare" Binding="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Row key" Binding="{Binding IsKey, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                            <DataGridTextColumn Header="Older field" Binding="{Binding OldHeader}" IsReadOnly="True" Width="*"/>
                            <DataGridTemplateColumn Header="Newer field" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding NewColumnOptions}" DisplayMemberPath="Name" SelectedItem="{Binding NewColumn, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="2">
                        <CheckBox x:Name="StrictTextCheck" Content="Strict text comparison (case and surrounding spaces matter)" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Back" Click="BackToFiles_Click"/>
                            <Button Content="Compare workbooks" Style="{StaticResource PrimaryButton}" Click="Compare_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem x:Name="ResultsTab" Header="  3  Review results  " IsEnabled="False">
                <Grid Margin="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,15">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Comparison results" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ResultSubtitle" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right" Content="Export Excel report…" Style="{StaticResource PrimaryButton}" Click="Export_Click"/>
                    </DockPanel>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,15">
                        <Border Background="#EEF2F8" CornerRadius="6" Margin="3" Padding="14"><StackPanel><TextBlock Text="UNCHANGED" Foreground="{StaticResource Muted}"/><TextBlock x:Name="UnchangedCount" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="#FFF4D8" CornerRadius="6" Margin="3" Padding="14"><StackPanel><TextBlock Text="● CHANGED" Foreground="#875A00"/><TextBlock x:Name="ChangedCount" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="#E8F7EE" CornerRadius="6" Margin="3" Padding="14"><StackPanel><TextBlock Text="+ ADDED" Foreground="#176A39"/><TextBlock x:Name="AddedCount" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="#FDECEC" CornerRadius="6" Margin="3" Padding="14"><StackPanel><TextBlock Text="− REMOVED" Foreground="#A22828"/><TextBlock x:Name="RemovedCount" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                        <Border Background="#F1ECFF" CornerRadius="6" Margin="3" Padding="14"><StackPanel><TextBlock Text="! WARNINGS" Foreground="#59339A"/><TextBlock x:Name="ProblemCount" Text="0" FontSize="26" FontWeight="Bold"/></StackPanel></Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SearchText" Grid.Column="0" ToolTip="Search keys, fields, or values" TextChanged="Filter_Changed"/>
                                <ComboBox x:Name="StatusFilter" Grid.Column="1" SelectionChanged="Filter_Changed">
                                    <ComboBoxItem Content="All statuses" IsSelected="True"/><ComboBoxItem Content="Changed"/><ComboBoxItem Content="Added"/><ComboBoxItem Content="Removed"/><ComboBoxItem Content="Unchanged"/>
                                </ComboBox>
                                <ComboBox x:Name="FieldFilter" Grid.Column="2" SelectionChanged="Filter_Changed"/>
                            </Grid>
                            <DataGrid x:Name="ResultsGrid" Grid.Row="1" SelectionChanged="ResultsGrid_SelectionChanged" IsReadOnly="True" SelectionMode="Single">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DifferenceStatus.Changed}"><Setter Property="Background" Value="#FFF9EA"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DifferenceStatus.Added}"><Setter Property="Background" Value="#EFFAF3"/></DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:DifferenceStatus.Removed}"><Setter Property="Background" Value="#FFF2F2"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100"/>
                                    <DataGridTextColumn Header="Row key" Binding="{Binding KeyDisplay}" Width="*"/>
                                    <DataGridTextColumn Header="Summary" Binding="{Binding ChangeSummary}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <Border Grid.Column="2" BorderBrush="#DDE3ED" BorderThickness="1" CornerRadius="6" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Selected row details" FontWeight="SemiBold" FontSize="17"/>
                                    <TextBlock x:Name="SelectedKeyText" Text="Select a row to see its values." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <DataGrid x:Name="DetailGrid" Grid.Row="1" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Field" Binding="{Binding FieldName}" Width="*"/>
                                        <DataGridTextColumn Header="Old value" Binding="{Binding OldValue}" Width="*"/>
                                        <DataGridTextColumn Header="New value" Binding="{Binding NewValue}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="White" BorderBrush="#DDE3ED" BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel>
                <TextBlock x:Name="StatusText" Text="Ready" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                <TextBlock DockPanel.Dock="Right" Text="Offline • Read-only sources • .xlsx" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <Border x:Name="BusyOverlay" Grid.RowSpan="3" Background="#AA172033" Visibility="Collapsed">
            <Border Background="White" CornerRadius="8" Padding="28" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="BusyTitle" Text="Working…" FontSize="20" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="BusyProgress" Height="12" Minimum="0" Maximum="100" Margin="0,18,0,12"/>
                    <TextBlock Text="Large workbooks may take a few moments. Your files stay on this computer." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                    <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,16,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
